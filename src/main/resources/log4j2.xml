<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Properties>
    <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n</Property>
    <Property name="APP_LOG_ROOT">logs</Property>
  </Properties>

  <Appenders>
    <!-- 控制台输出 -->
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout>
        <!-- 控制台日志只打时间，不打日期 -->
        <Pattern>%d{HH:mm:ss.SSS} %highlight{${LOG_LEVEL_PATTERN:-%5p}}{FATAL=red, ERROR=red, WARN=yellow,
          INFO=green, DEBUG=green, TRACE=green} --- [%15.15t] %logger{1} - %m%n%ex
        </Pattern>
      </PatternLayout>
    </Console>

    <!-- 文件输出 - 应用日志（按小时拆分，最多保留 7 天、最多 100 个） -->
    <RollingFile name="AppLog"
                 fileName="${APP_LOG_ROOT}/device.log"
                 filePattern="${APP_LOG_ROOT}/device-%d{yyyy-MM-dd-HH}-%i.log">
      <PatternLayout pattern="${LOG_PATTERN}"/>
      <Policies>
        <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
        <SizeBasedTriggeringPolicy size="100MB"/>
      </Policies>
      <DefaultRolloverStrategy max="100">
        <Delete basePath="${APP_LOG_ROOT}" maxDepth="1">
          <IfFileName glob="device-*.log">
            <IfAny>
              <IfLastModified age="P7D"/>
              <IfAccumulatedFileCount exceeds="100"/>
            </IfAny>
          </IfFileName>
        </Delete>
      </DefaultRolloverStrategy>
    </RollingFile>

    <!-- 文件输出 - 错误日志 -->
    <RollingFile name="ErrorLog"
                 fileName="${APP_LOG_ROOT}/device-error.log"
                 filePattern="${APP_LOG_ROOT}/device-error-%d{yyyy-MM-dd}-%i.log">
      <PatternLayout pattern="${LOG_PATTERN}"/>
      <Policies>
        <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
        <SizeBasedTriggeringPolicy size="100MB"/>
      </Policies>
      <DefaultRolloverStrategy max="10"/>
      <Filters>
        <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
      </Filters>
    </RollingFile>

    <!-- 文件输出 - 回放帧（JSONL，每行一帧；按小时拆分，最多保留 7 天、最多 100 个） -->
    <RollingFile name="ReplayLog"
                 fileName="${APP_LOG_ROOT}/replay.log"
                 filePattern="${APP_LOG_ROOT}/replay-%d{yyyy-MM-dd-HH}-%i.log">
      <PatternLayout pattern="%m%n"/>
      <Policies>
        <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
        <SizeBasedTriggeringPolicy size="100MB"/>
      </Policies>
      <DefaultRolloverStrategy max="100">
        <Delete basePath="${APP_LOG_ROOT}" maxDepth="1">
          <IfFileName glob="replay-*.log">
            <IfAny>
              <IfLastModified age="P7D"/>
              <IfAccumulatedFileCount exceeds="100"/>
            </IfAny>
          </IfFileName>
        </Delete>
      </DefaultRolloverStrategy>
    </RollingFile>
  </Appenders>

  <Loggers>
    <!-- 应用程序日志配置 -->
    <Logger name="org.dao" level="DEBUG" additivity="false">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="AppLog"/>
<!--      <AppenderRef ref="ErrorLog"/>-->
    </Logger>

    <!-- 回放帧日志：独立写入 replay.log，不打印到控制台/应用日志 -->
    <Logger name="REPLAY" level="INFO" additivity="false">
      <AppenderRef ref="ReplayLog"/>
    </Logger>

    <!-- 根日志配置 -->
<!--    <Root level="INFO">-->
<!--      <AppenderRef ref="Console"/>-->
<!--      <AppenderRef ref="AppLog"/>-->
<!--    </Root>-->
  </Loggers>
</Configuration>
